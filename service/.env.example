# 本地环境变量（复制为 .env 后填写）
# 勿提交含真实密钥的 .env

# ---------- 必填 ----------
# 火山方舟 API Key（DeepSeek 等模型；也可用 LLM_API_KEY / VOLCENGINE_API_KEY）
ARK_API_KEY=
# 推理接入点 ID（控制台创建后形如 ep-xxxxxxxxxx-xxxxx）
ARK_MODEL=

# 本地 ASR 模型目录（相对 service/ 项目根）

# ---------- 常用可选 ----------
# 主配置文件（默认 config.yaml）
# DESKBOT_SERVER_CONFIG=config.yaml

# LLM 流式首字超时（秒，仅 openai 等流式协议；ark_responses 默认关闭）
# LLM_FIRST_TOKEN_TIMEOUT=15
# LLM_PROTOCOL=ark_responses   # openai / dashscope / ark / ark_responses
# LLM_MODEL=ep-xxxxxxxxxx-xxxxx
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 兼容旧版阿里云 DashScope（可选）
# LLM_API_KEY=
# DASHSCOPE_API_KEY=

# WebSocket 服务
# DESKBOT_SERVER_HOST=0.0.0.0
# DESKBOT_SERVER_PORT=9000
# DESKBOT_WS_PATH=/asr_chat
# DESKBOT_WS_PING_INTERVAL=120
# DESKBOT_WS_PING_TIMEOUT=300
# WS_SEND_TIMEOUT_SEC=10

# TTS 后端：moss-tts-nano（独立进程 tts-engine，默认）/ doubao（火山引擎豆包）
# TTS_PROVIDER=moss-tts-nano
# moss-tts-nano 音色由 config.yaml tts.demo_id 配置（demo-N）；豆包凭证见
# DOUBAO_TTS_* / .env；调试页「TTS 调试」可配置
# TTS_SPK_ID=0
# TTS_SAMPLE_RATE=48000

# pb 脸动画（默认：deskbot-face.json 的 emotions + phonemes）
# DESKBOT_PB_FACE_BUNDLE=demo
# DESKBOT_PB_FACE_BUNDLE_JSON=/path/to/custom_face_bundle.json
# DESKBOT_PB_FACE_BUNDLE_FILE=/path/to/overlay.yaml

# 下行协议开关（默认 pb-only=true，见 config.yaml server.*）
# DESKBOT_ASR_CHAT_DEVICE_PB_ONLY=1
# DESKBOT_ASR_CHAT_MINIMAL_DOWNLINK=0
# DESKBOT_SEND_FACE_INFO=0
# DESKBOT_PB_RANDOM_SERVO=0
# DESKBOT_PB_IDLE_SNORE_SEC=5
# DESKBOT_PB_IDLE_SNORE_SCENE=sleep_snore

# FastAPI Web 控制台（默认监听所有网卡，局域网可访问）
DESKBOT_WEB_HOST=0.0.0.0
# DESKBOT_WEB_PORT=9000
# DESKBOT_WEB_PUBLIC_HOST=
# 启用 Flask 开发服务器 debug 模式（默认关闭；生产环境切勿开启）
# DESKBOT_WEB_DEBUG=0

# ---------- 用户认证（SQLite，邮箱+密码本地登录）----------
# Session 签名密钥（生产环境请设置随机长字符串；亦用于调试台 WS debug_token 签名）
# DESKBOT_WEB_SECRET_KEY=
# 已登录调试台 WebSocket 令牌有效天数（默认 7，最大 30）
# DESKBOT_DEBUG_WS_TOKEN_DAYS=7
# DESKBOT_DB_PATH=./data/opendesk.db
# 首次启动自动创建免费体验 API Key（每日 1GB），写入 data/.free_api_key

# 摄像头人脸（推理全在外部 insightface-engine，主服务只管外部地址）
# 地址/超时默认读 config.yaml camera_face.external_url / external_timeout_s
# 推理参数（landmarker 路径/undistort/置信度）见 externals/insightface-engine/config.yaml

# 日志
# DESKBOT_SERVER_LOG_FILE=app.log
# DESKBOT_SERVER_LOG_LEVEL=INFO

# ---------- 豆包云 ASR 一句话识别（可选，机器人设置页 ASR「配置」）----------
# DOUBAO_ASR_APP_ID=       # 应用 ID（控制台创建应用并开通一句话识别）
# DOUBAO_ASR_ACCESS_TOKEN= # 应用令牌（Authorization: Bearer; {token}）
# DOUBAO_ASR_CLUSTER=      # Cluster ID（控制台开通服务后显示）
# DOUBAO_ASR_URL=https://openspeech.bytedance.com/api/v1/asr
# DOUBAO_ASR_UID=deskbot   # 用户标识
# DOUBAO_ASR_WORKFLOW=     # 识别流程（留空用标准版含标点）

# ---------- 豆包语音 TTS 2.0（可选，调试台 /debug/tts）----------
# 新版控制台：仅需 Seed Speech API Key
# DOUBAO_TTS_API_KEY=
# DOUBAO_TTS_SPEAKER=zh_male_dongmanhaimian_mars_bigtts
# DOUBAO_TTS_RESOURCE_ID=seed-tts-1.0
# DOUBAO_TTS_MODEL=
# DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# DOUBAO_TTS_SAMPLE_RATE=24000
# DOUBAO_TTS_FORMAT=pcm
# DOUBAO_TTS_ENABLE_TIMESTAMP=1

# ---------- 启动脚本 ----------
# 跳过 pip 重装（venv 须已完整）
FAST_START=0
